03\u0008\u0084\u0001H\u0007\u00a2\u0006\u0003\u0010\u00a4\u0001\u001a1\u0010\u00a5\u0001\u001a\u00020\u00012\u0008\u0010\u009c\u0001\u001a\u00030\u009d\u00012\u0007\u0010\u00a6\u0001\u001a\u00020\u00162\r\u0010\u00a7\u0001\u001a\u0008\u0012\u0004\u0012\u00020\u000108H\u0007\u00a2\u0006\u0003\u0010\u00a8\u0001\u001a\u0019\u0010\u00a9\u0001\u001a\u00020\u00012\u0008\u0010\u009c\u0001\u001a\u00030\u009d\u0001H\u0007\u00a2\u0006\u0003\u0010\u00aa\u0001\u001a:\u0010\u00ab\u0001\u001a\u00020\u00012\u0007\u0010\u00ac\u0001\u001a\u00020\"2\t\u0008\u0002\u0010\u00ad\u0001\u001a\u00020\"2\u0007\u0010\u00ae\u0001\u001a\u00020\u00032\u000c\u0010]\u001a\u0008\u0012\u0004\u0012\u00020\u000108H\u0003\u00a2\u0006\u0003\u0010\u00af\u0001\u001a%\u0010\u00b0\u0001\u001a\u00020\u00012\u0007\u0010\u00b1\u0001\u001a\u00020\u00032\u000c\u0010]\u001a\u0008\u0012\u0004\u0012\u00020\u000108H\u0003\u00a2\u0006\u0002\u0010H\u001a6\u0010\u00b2\u0001\u001a\u00020\u00012\u0019\u0010\u00b3\u0001\u001a\u0014\u0012\u0010\u0012\u000e\u0012\u0004\u0012\u00020\u0008\u0012\u0004\u0012\u00020\u001d0\u001c0\u000b2\u0007\u0010\u00b4\u0001\u001a\u00020\u001dH\u0003\u00a2\u0006\u0006\u0008\u00b5\u0001\u0010\u00b6\u0001\u001a\u001e\u0010\u00b7\u0001\u001a\u00020\u00012\r\u0010\u00b8\u0001\u001a\u0008\u0012\u0004\u0012\u00020\u001d0\u000bH\u0003\u00a2\u0006\u0003\u0010\u00b9\u0001\u001aN\u0010\u00ba\u0001\u001a\u00020\u00012\r\u0010\u00b8\u0001\u001a\u0008\u0012\u0004\u0012\u00020\u001d0\u000b2\u0007\u0010\u0081\u0001\u001a\u00020\u00032\u0007\u0010\u00bb\u0001\u001a\u00020\u007f2\u0006\u0010K\u001a\u00020\u00082\t\u0008\u0002\u0010\u00bc\u0001\u001a\u00020\u00032\t\u0008\u0002\u0010\u00bd\u0001\u001a\u00020\"H\u0003\u00a2\u0006\u0003\u0010\u00be\u0001\u001a1\u0010\u00bf\u0001\u001a\u00020\u00012\u0007\u0010\u00a0\u0001\u001a\u00020\u00032\u0017\u0008\u0002\u0010\u0095\u0001\u001a\u0010\u0012\u0004\u0012\u00020\u0001\u0018\u000108\u00a2\u0006\u0003\u0008\u0084\u0001H\u0003\u00a2\u0006\u0003\u0010\u00c0\u0001\u